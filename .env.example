TYPESAFE_API_KEY=

# Astranomy Direct-API: local OpenAI-compatible model service.
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
AI_NATIVE_MODEL=qwen3.8-flash-next-nvfp4-nvfp4
